    "type": "wordpress-plugin",
    "keywords": [
        "wordpress",
        "plugin",
        "wp-sweep",
        "sweep"
    ],
    "homepage": "https://wordpress.org/plugins/wp-sweep/",
    "license": [
        "GPL-2.0-only"
    ],
    "authors": [
        {
            "name": "Lester Chan",
            "email": "lesterchan@gmail.com"
        }
    ],
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "allow-plugins": false
    }
}
